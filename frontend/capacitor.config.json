{
  "appId": "com.hostel.attendance",
  "appName": "HostelGuard",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "allowNavigation": ["*"]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "Geolocation": {
      "permissions": ["location"]
    },
    "Camera": {
      "permissions": ["camera", "photos"]
    }
  }
}
